{
    "version": "0.1.0",
    "nodeModulesDir": "auto",
    "tasks": {
        "dev": "deno run -A npm:vite@7.1.7 --config web/vite.config.ts",
        "dev:api": "ENCRYPTION_KEY=abc deno run -A --watch src/main.ts",
        "build": "deno run -A npm:vite@7.1.7 build --config web/vite.config.ts",
        "start": "deno run -A src/main.ts",
        "db:generate": "deno run -A npm:drizzle-kit@0.31.4 generate",
        "db:migrate": "deno run -A src/db/migrate.ts",
        "admin:create": "deno run -A src/commands/admin.ts create",
        "admin:reset": "deno run -A src/commands/admin.ts reset",
        "test": "deno test -A src web/src",
        "test:routing": "deno run -A scripts/e2e/run.ts routing",
        "test:workspace": "deno run -A scripts/e2e/run.ts workspace --parallel",
        "test:workspace:serial": "deno run -A scripts/e2e/run.ts workspace --serial",
        "test:workspace:parallel": "deno run -A scripts/e2e/run.ts workspace --parallel",
        "test:workspace:apps": "deno run -A scripts/e2e/run.ts apps",
        "test:workspace:notes": "deno run -A scripts/e2e/run.ts notes",
        "test:workspace:layout": "deno run -A scripts/e2e/run.ts layout",
        "test:e2e:full": "deno run -A scripts/e2e/run.ts full",
        "check:e2e": "deno run -A scripts/e2e/run.ts check",
        "test:documents": "deno run -A scripts/e2e/run.ts documents",
        "test:wallpaper": "deno run -A scripts/e2e/run.ts wallpaper",
        "test:bundle": "deno run -A scripts/e2e/run.ts bundle",
        "test:home-notes": "deno run -A scripts/e2e/run.ts home-notes",
        "check:ui": "deno run -A scripts/check-ui.ts",
        "check:bundle": "deno task build && deno run --allow-read --allow-env scripts/check-bundle.ts"
    },
    "imports": {
        "@internal/": "./src/internal/",
        "icojs": "npm:icojs@0.20.1",
        "sharp": "npm:sharp@0.34.5",
        "typescript": "npm:typescript@5.9.3",
        "@logger": "./src/internal/logger/logger.ts",
        "@shared/": "./src/shared/",
        "@std/assert": "jsr:@std/assert@1.0.19",
        "@std/cli": "jsr:@std/cli@1.0.23",
        "@std/fmt": "jsr:@std/fmt@1.0.10",
        "@std/fs": "jsr:@std/fs@1.0.24",
        "@std/http": "jsr:@std/http@1.1.3",
        "@std/path": "jsr:@std/path@1.1.6",
        "@valibot/valibot": "jsr:@valibot/valibot@1.4.2",
        "@vitejs/plugin-react": "npm:@vitejs/plugin-react@5.0.4",
        "@tailwindcss/vite": "npm:@tailwindcss/vite@4.1.13",
        "tailwindcss": "npm:tailwindcss@4.1.13",
        "@base-ui/react": "npm:@base-ui/react@1.0.0",
        "@assistant-ui/react": "npm:@assistant-ui/react@0.15.2",
        "@assistant-ui/core/internal": "npm:@assistant-ui/core@0.3.21/internal",
        "assistant-cloud": "npm:assistant-cloud@0.2.3",
        "class-variance-authority": "npm:class-variance-authority@0.7.1",
        "clsx": "npm:clsx@2.1.1",
        "tailwind-merge": "npm:tailwind-merge@3.3.1",
        "@dnd-kit/core": "npm:@dnd-kit/core@6.3.1",
        "@dnd-kit/sortable": "npm:@dnd-kit/sortable@10.0.0",
        "@dnd-kit/utilities": "npm:@dnd-kit/utilities@3.2.2",
        "react-markdown": "npm:react-markdown@10.1.0",
        "remark-gfm": "npm:remark-gfm@4.0.1",
        "remark-breaks": "npm:remark-breaks@4.0.0",
        "remark": "npm:remark@15.0.1",
        "remark-parse": "npm:remark-parse@11.0.0",
        "unified": "npm:unified@11.0.5",
        "rehype-sanitize": "npm:rehype-sanitize@6.0.0",
        "@milkdown/core": "npm:@milkdown/core@7.22.2",
        "@milkdown/ctx": "npm:@milkdown/ctx@7.22.2",
        "@milkdown/plugin-history": "npm:@milkdown/plugin-history@7.22.2",
        "@milkdown/preset-commonmark": "npm:@milkdown/preset-commonmark@7.22.2",
        "@milkdown/preset-gfm": "npm:@milkdown/preset-gfm@7.22.2",
        "@milkdown/prose": "npm:@milkdown/prose@7.22.2",
        "@milkdown/utils": "npm:@milkdown/utils@7.22.2",
        "happy-dom": "npm:happy-dom@17.4.2",
        "@deno/vite-plugin": "npm:@deno/vite-plugin@2.0.3",
        "drizzle-kit": "npm:drizzle-kit@0.31.4",
        "@types/node": "npm:@types/node@26.6.2",
        "@types/react": "npm:@types/react@19.3.0",
        "@types/react-dom": "npm:@types/react-dom@19.3.0",
        "drizzle-orm": "npm:drizzle-orm@0.45.2",
        "fflate": "npm:fflate@0.8.2",
        "hono": "jsr:@hono/hono@4.13.7",
        "lucide-react": "npm:lucide-react@0.468.0",
        "openai": "npm:openai@7.23.0",
        "pino": "npm:pino@10.3.1",
        "pino-pretty": "npm:pino-pretty@13.1.3",
        "playwright": "npm:playwright@1.56.1",
        "react": "npm:react@19.1.1",
        "react-dom": "npm:react-dom@19.1.1",
        "react-router-dom": "npm:react-router-dom@7.9.1",
        "rotating-file-stream": "npm:rotating-file-stream@3.2.9",
        "vite": "npm:vite@7.1.7"
    },
    "compilerOptions": {
        "lib": ["deno.window", "dom", "dom.iterable"],
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "strict": true
    },
    "lint": {
        "rules": { "exclude": ["no-sloppy-imports"] },
        "exclude": [
            "web/.vite/",
            "web/dist/",
            "node_modules/",
            "drizzle/",
            ".llm-wiki/"
        ]
    },
    "fmt": {
        "indentWidth": 4,
        "proseWrap": "preserve",
        "exclude": [
            "./AGENTS.md",
            "./drizzle",
            "web/.vite/",
            "web/dist/",
            "node_modules/",
            ".llm-wiki/",
            ".omp/",
            "README.md",
            "docs/plans/WORKSPACE_LAYOUT_REDESIGN_PLAN.md"
        ]
    }
}
