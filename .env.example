APP_ORIGIN=http://localhost:34567
PORT=34567
DATABASE_PATH=./data/searcher.sqlite
NODE_ENV=development
# Required when configuring AI providers; keep stable to decrypt stored API keys.
ENCRYPTION_KEY=replace-with-a-long-random-secret
# Optional SearxNG instance with JSON search enabled; unset disables Ask Web Search.
# Example: http://localhost:8080 (the adapter calls /search?format=json).
SEARXNG_URL=
